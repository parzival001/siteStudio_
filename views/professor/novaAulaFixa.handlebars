{{!-- views/professor/novaAulaFixa.handlebars --}}
<div class="container py-5 text-white">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h2 class="mb-0">Aulas Liberadas — Gerenciar Alunos</h2>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/professor/semana" class="btn btn-outline-light btn-sm">← Painel Semana</a>
          <a href="/professor/semana/historico" class="btn btn-outline-info btn-sm">📜 Histórico</a>
          <form method="POST" action="/professor/aulas-fixas/arquivar-todas" class="d-inline"
            onsubmit="return confirm('Arquivar TODAS as aulas liberadas? Isso encerra a semana e move tudo para o histórico.');">
            <button type="submit" class="btn btn-secondary btn-sm">📦 Arquivar TODAS</button>
          </form>
        </div>
      </div>

      {{!-- Flash messages do arquivamento --}}
      {{#if (eq msg "arquivada")}}
      <div class="alert alert-success">📦 Aula arquivada! Foi movida para o histórico.</div>
      {{/if}}
      {{#if (eq msg "ja_arquivada")}}
      <div class="alert alert-info">ℹ️ Esta aula já estava arquivada.</div>
      {{/if}}
      {{#if (eq msg "nao_liberada")}}
      <div class="alert alert-warning">⚠️ Você só pode arquivar uma aula que já foi liberada.</div>
      {{/if}}
      {{#if (eq msg "lote_arquivado")}}
      <div class="alert alert-success">📦 {{arquivadas}} aula(s) arquivada(s) com sucesso!</div>
      {{/if}}

      <div class="alert alert-secondary small text-dark">
        Aqui aparecem as aulas que você já liberou na semana corrente.
        Para <strong>criar</strong> uma nova aula fixa, vá ao
        <a href="/professor/semana"><strong>Painel da Semana</strong></a>.
      </div>

      {{#each aulasFixas}}
      <div class="border rounded p-4 mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div>
            <h5 class="mb-1">{{this.categoria_nome}}</h5>
            <h6 class="mb-1 text-muted">{{this.professor_nome}}</h6>
            <p class="mb-1"><strong>{{this.dia_semana}} - {{this.horario_fmt}}</strong></p>
            <p class="mb-1"><strong>Próxima:</strong> {{this.proxima_data_fmt}}</p>
            <p class="mb-1"><strong>Vagas:</strong> {{this.vagas}}</p>
          </div>
          <div class="text-end">
            {{#if this.semana_arquivada}}
            <div class="alert alert-warning mt-2">
              📦 AULA ARQUIVADA - TESTE
            </div>
            {{else}}
            <div class="alert alert-success mt-2">
              ✅ AULA LIBERADA
            </div>
            {{/if}}
          </div>
        </div>

        {{#each this.alunos_fixos}}
  {{#if @first}}
    <h6 class="mt-3">Alunos cadastrados:</h6>
    <ul class="list-group mb-3">
  {{/if}}

  <li class="list-group-item d-flex justify-content-between align-items-center">
    {{this.nome}}
    <form method="POST" action="/professor/aulas-fixas/{{this.aula_fixa_id}}/remover-aluno/{{this.aluno_id}}">
      <button class="btn btn-sm btn-outline-danger">Remover</button>
    </form>
  </li>

  {{#if @last}}
    </ul>
  {{/if}}
{{else}}
  <p class="text-muted">Nenhum aluno cadastrado.</p>
{{/each}}

        <form method="POST" action="/professor/aulas-fixas/{{this.id}}/adicionar-aluno" class="mb-3">
          <div class="mb-2">
            <input type="text" class="form-control" placeholder="Buscar aluno pelo nome..."
              oninput="filtrarAlunos(this, 'aluno-select-{{this.id}}')">
          </div>

          <div class="d-flex gap-2">
            <select id="aluno-select-{{this.id}}" name="aluno_id" class="form-select" required>
              {{#each (sortBy ../alunos "nome")}}
              <option value="{{this.id}}">{{this.nome}}</option>
              {{/each}}
            </select>
            <button type="submit" class="btn btn-outline-custom">Adicionar Aluno</button>
          </div>
        </form>

        {{!-- Ações: arquivar (sempre disponível aqui) + deletar --}}
        <div class="d-flex gap-2 flex-wrap">
          <form method="POST" action="/professor/aulas-fixas/arquivar/{{this.id}}" class="flex-grow-1"
            onsubmit="return confirm('Arquivar esta aula? Ela some daqui e vai para o histórico.');">
            <button class="btn btn-secondary w-100">📦 Arquivar Aula</button>
          </form>

          <form method="POST" action="/professor/aulas-fixas/deletar/{{this.id}}" class="flex-grow-1"
            onsubmit="return confirm('Deseja realmente excluir esta aula fixa?');">
            <button class="btn btn-outline-danger w-100">🗑️ Deletar Aula</button>
          </form>
        </div>
      </div>
      {{else}}
      <div class="alert alert-info text-dark">
        <strong>Nenhuma aula liberada nesta semana.</strong><br>
        Vá em <a href="/professor/semana"><strong>Liberar Aulas da Semana</strong></a> para liberar as aulas fixas e
        elas aparecerão aqui.
      </div>
      {{/each}}

      <div class="text-center mt-4">
        <a href="../home" class="btn btn-outline-custom">Voltar para Home</a>
      </div>

    </div>
  </div>

  <script>
    function filtrarAlunos(input, selectId) {
      const filtro = input.value.toLowerCase();
      const select = document.getElementById(selectId);

      for (const option of select.options) {
        const nome = option.textContent.toLowerCase();
        option.style.display = nome.includes(filtro) ? 'block' : 'none';
      }

      const visiveis = [...select.options].filter(opt => opt.style.display !== 'none');
      if (visiveis.length > 0) {
        select.value = visiveis[0].value;
      }
    }
  </script>
</div>